{
  "name": "homebridge-salus-cloud",
  "displayName": "Salus Cloud",
  "type": "module",
  "version": "0.1.41",
  "description": "Cloud-only Salus Connect Homebridge platform with automatic discovery and HomeKit control.",
  "author": "Marcel",
  "license": "Apache-2.0",
  "homepage": "https://github.com/marcel/homebridge-salus-cloud#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/marcel/homebridge-salus-cloud.git"
  },
  "bugs": {
    "url": "https://github.com/marcel/homebridge-salus-cloud/issues"
  },
  "keywords": [
    "homebridge-plugin",
    "homebridge",
    "salus",
    "salusconnect",
    "thermostat"
  ],
  "main": "dist/index.js",
  "engines": {
    "node": "^20.18.0 || ^22.10.0 || ^24.0.0",
    "homebridge": "^1.8.0 || ^2.0.0-beta.0"
  },
  "scripts": {
    "build": "rimraf ./dist && tsc",
    "lint": "eslint . --max-warnings=0",
    "prepublishOnly": "npm run lint && npm run build",
    "version:bump:major": "npm version major",
    "version:bump:minor": "npm version minor",
    "version:bump:revision": "npm version patch",
    "publish:plugin": "bash ./scripts/publish.sh",
    "publish:plugin:dry-run": "bash ./scripts/publish.sh --dry-run",
    "watch": "npm run build && npm link && nodemon"
  },
  "dependencies": {
    "mqtt": "^5.14.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^24.10.1",
    "eslint": "^9.39.1",
    "homebridge": "^2.0.0-beta.55",
    "nodemon": "^3.1.11",
    "rimraf": "^6.1.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.4"
  }
}
